{
  "name": "ilmomasiina",
  "version": "3.0.0-alpha.1",
  "private": true,
  "bugs": {
    "url": "https://github.com/aapolaakkio/ilmomasiina/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aapolaakkio/ilmomasiina"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --build",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix src tests",
    "format": "oxfmt \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "db:migrate": "npx tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "^16.2.1",
    "@react-email/components": "^1.0.10",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/typography": "^0.5.19",
    "dotenv": "^17.3.1",
    "drizzle-orm": "1.0.0-beta.18-7eb39f0",
    "ics": "^3.11.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.8.3",
    "next-safe-action": "^8.1.8",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^21.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "1.0.0-beta.18-7eb39f0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "postcss": "^8.5.8",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {},
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "simple-git-hooks"
    ]
  }
}
