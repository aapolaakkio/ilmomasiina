# This file contains example configuration for Ilmomasiina.
# Copy it to .env, read thoroughly and update to match your environment.


# HTTP port for Next.js (`next dev` / `next start`). Docker image sets PORT=3000.
PORT=3000


# Database settings

# NOTE: Only Postgres is supported in Ilmomasiina 3.0 and later.

DATABASE_URL=postgresql://ilmo_user:password@localhost:5432/ilmomasiina
#DB_SSL=false
#DEBUG_DB_LOGGING=false

# Time limit settings

# How long each user has to edit their signup after creation.
SIGNUP_CONFIRM_MINS=30
# Whether signups can be edited for SIGNUP_CONFIRM_MINS after creation, even if
# signups for the event have closed.
# It's recommended to enable this to improve the user experience, but it's off
# by default for backwards compatibility.
SIGNUP_CONFIRM_AFTER_CLOSE=true

# Privacy-related settings

# How long after an event's date to remove signup details.
ANONYMIZE_AFTER_DAYS=180

# How long after an event's date it will become fully invisible to users.
HIDE_EVENT_AFTER_DAYS=180

# How long items stay in the database after deletion, in order to allow restoring
# accidentally deleted items.
DELETION_GRACE_PERIOD_DAYS=14


# Authentication secrets

# Set these to secure random strings.
# You can generate one with the command:
# openssl rand -hex 32
NEW_EDIT_TOKEN_SECRET=
AUTH_SECRET=

# Google OAuth credentials (from https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Session lifetime in seconds (default: 10800 = 3 hours)
#SESSION_TTL=10800

# Secret for authenticating cron job API requests.
# External schedulers call POST /api/cron/every-minute and /api/cron/daily
# with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# If migrating from an Athene version of Ilmomasiina, copy this setting over to
# allow old links to work. Otherwise, leave this empty.
EDIT_TOKEN_SALT=


# App time zone (IANA). Used server-side and client-side.
NEXT_PUBLIC_APP_TIMEZONE=Europe/Helsinki


# Default language for frontend, new events, emails, iCalendar exports, and
# signups for which no language is known. Requires frontend rebuild.
NEXT_PUBLIC_DEFAULT_LANGUAGE=fi


# Mail settings

# Mail sender
MAIL_FROM=<ilmo@athene.fi>

# If you want to send emails, configure SMTP.
# In development, you can omit SMTP settings and emails will be printed to the console.

# SMTP server host and credentials, if using direct SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# URL settings

# Canonical base URL for the app. Used by the backend.
BASE_URL=http://localhost:3000

# Domain name to use for iCalendar UIDs. Should be kept constant.
# Defaults to the domain of BASE_URL.
#ICAL_UID_DOMAIN=


# Branding settings

# Website strings (requires frontend rebuild)
NEXT_PUBLIC_BRANDING_HEADER_TITLE_TEXT=Kilta ry ilmomasiina
NEXT_PUBLIC_BRANDING_HEADER_TITLE_TEXT_SHORT=Ilmomasiina
NEXT_PUBLIC_BRANDING_FOOTER_GDPR_TEXT=Tietosuoja
NEXT_PUBLIC_BRANDING_FOOTER_GDPR_LINK=http://example.com/privacy
NEXT_PUBLIC_BRANDING_FOOTER_HOME_TEXT=Example.com
NEXT_PUBLIC_BRANDING_FOOTER_HOME_LINK=http://example.com
# Email strings
BRANDING_MAIL_FOOTER_TEXT=Rakkaudella, Tietskarijengi & Athene
BRANDING_MAIL_FOOTER_LINK=https://ilmo.athene.fi

# iCalendar exported calendar name
BRANDING_ICAL_CALENDAR_NAME=Ilmomasiina


# Payment settings

# The currency used for payments. Requires frontend rebuild.
CURRENCY=EUR

# Stripe secret API key for payments.
#STRIPE_SECRET_KEY=
# Stripe webhook signing secret for verifying webhook events.
#STRIPE_WEBHOOK_SECRET=
# Stripe Checkout session expiry time in minutes. Must be between 30 and 1440 (24 hours).
#STRIPE_CHECKOUT_EXPIRY_MINS=30

# Stripe customization options (JSON). Validated by the backend. See:
# https://docs.stripe.com/payments/checkout/customization/appearance?payment-ui=stripe-hosted
# https://docs.stripe.com/api/checkout/sessions/create#create_checkout_session-branding_settings
#STRIPE_BRANDING_JSON=
