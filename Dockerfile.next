# syntax=docker/dockerfile:1.15-labs

# Build stage
FROM node:24-alpine AS builder

WORKDIR /opt/ilmomasiina

# Copy files needed for dependency installation
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN corepack enable && pnpm install --frozen-lockfile

# Copy source files
COPY . .

# Default to production
ENV NODE_ENV=production

# Build Next.js app (standalone output)
RUN pnpm build

# Runtime stage
FROM node:24-alpine AS runner

ARG VERSION
ENV VERSION=$VERSION
ENV NODE_ENV=production
ENV HOST=0.0.0.0

WORKDIR /opt/ilmomasiina

# Copy standalone Next.js build
COPY --from=builder /opt/ilmomasiina/.next/standalone ./
COPY --from=builder /opt/ilmomasiina/.next/static ./.next/static
COPY --from=builder /opt/ilmomasiina/public ./public

# Copy email templates (used at runtime by the email service)
COPY --from=builder /opt/ilmomasiina/emails ./emails

# Create non-root user
RUN adduser -D -h /opt/ilmomasiina ilmomasiina
USER ilmomasiina

EXPOSE 3000

# Start Next.js server
CMD ["node", "server.js"]
